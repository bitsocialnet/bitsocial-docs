  "husky": {
    "hooks": {
      "pre-commit": "corepack yarn deps:check-pinned && lint-staged",
      "prepare-commit-msg": "(exec < /dev/tty) 2>/dev/null && exec < /dev/tty && cz --hook || true"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "oxlint --config oxlint.json --fix --react-plugin",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{json,css}": "oxfmt --no-error-on-unmatched-pattern"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": "22.x"
  },
  "packageManager": "yarn@4.13.0"
