{
  "name": "bitsocial-docs",
  "version": "0.0.0",
  "private": true,
  "description": "Bitsocial documentation site, served at docs.bitsocial.net.",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bitsocialnet/bitsocial-docs.git"
  },
  "author": "Bitsocial Forge",
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "start:docs": "node scripts/start-docs.mjs",
    "start:docs:live": "node scripts/start-docs.mjs --mode=live",
    "build": "yarn build:static && yarn pagefind:build",
    "build:static": "docusaurus build",
    "build:verify": "yarn build:static --locale en && yarn pagefind:build",
    "build:profile": "REACT_PERF_PROFILE=1 yarn build:static --locale en --out-dir dist-profile",
    "pagefind:build": "pagefind --site build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc",
    "deps:check-pinned": "node scripts/check-pinned-versions.mjs",
    "deps:check-hardened": "YARN_ENABLE_HARDENED_MODE=1 yarn install --immutable",
    "deps:install:hardened": "YARN_ENABLE_HARDENED_MODE=1 yarn install",
    "knip": "knip --production --include dependencies,unlisted,binaries --no-progress",
    "knip:full": "knip --no-progress --no-exit-code",
    "lint": "oxlint --config oxlint.json --react-plugin",
    "lint:fix": "oxlint --config oxlint.json --fix --react-plugin",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "commit": "cz",
    "ai-workflow:sync": "node scripts/sync-ai-workflow.mjs",
    "ai-workflow:check": "node scripts/validate-ai-workflow.mjs",
    "ai-workflow:test": "node --test scripts/__tests__/ai-workflow.node-test.mjs scripts/__tests__/agent-hooks.node-test.mjs",
    "doctor": "react-doctor . -y",
    "doctor:verbose": "react-doctor . --verbose -y",
    "doctor:scan": "react-doctor scan",
    "doctor:check": "node scripts/react-perf/doctor-check.mjs",
    "perf:check": "node scripts/react-perf/runner.mjs check",
    "perf:record": "node scripts/react-perf/runner.mjs record",
    "perf:test": "node scripts/react-perf/runner.mjs selftest",
    "perf:install": "node scripts/react-perf/install-browser.mjs",
    "agent:verify": "yarn build:verify && yarn doctor:check && yarn perf:check"
  },
  "dependencies": {
    "@docusaurus/core": "3.9.2",
