{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/anti-spam/spam-blocker",
      "destination": "/anti-spam/spamblocker/",
      "permanent": true
    },
    {
      "source": "/anti-spam/spam-blocker/",
      "destination": "/anti-spam/spamblocker/",
      "permanent": true
    },
    {
      "source": "/:locale/anti-spam/spam-blocker",
      "destination": "/:locale/anti-spam/spamblocker/",
      "permanent": true
    },
    {
      "source": "/:locale/anti-spam/spam-blocker/",
      "destination": "/:locale/anti-spam/spamblocker/",
      "permanent": true
    }
  ]
}
